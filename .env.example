# AliExpress Open Platform (gratis): https://portals.aliexpress.com -> App Key / Secret / Tracking ID
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=

# Google AI Studio (capa gratuita): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: cualquier modelo de Gemini con salida JSON por esquema
GEMINI_MODEL=gemini-2.5-flash

# Voz (edge-tts, gratis). Femeninas US: en-US-AriaNeural, en-US-JennyNeural, en-US-AvaNeural, en-US-EmmaNeural
TTS_VOICE=en-US-AriaNeural
TTS_RATE=+15%
TTS_PITCH=+2Hz
# PYTHON_BIN=python
# FFMPEG_BIN=C:\ffmpeg\bin\ffmpeg.exe
# FFPROBE_BIN=C:\ffmpeg\bin\ffprobe.exe
# SUBS_FONT=Arial Black

# Pexels (gratis, 200 búsquedas/hora): https://www.pexels.com/api/
PEXELS_API_KEY=
